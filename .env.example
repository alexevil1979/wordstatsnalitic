# App
APP_URL=https://wordstat.1tlt.ru
AUTH_SECRET=change-me-long-random
CREDENTIALS_ENCRYPTION_KEY=change-me-another-long-random
ADMIN_EMAIL=admin@example.com

# Default live provider: google_trends | serpapi | dataforseo | ahrefs | expert_seed
KEYWORD_PROVIDER=google_trends
TRENDS_CACHE_TTL_HOURS=24

# Optional explicit Python for pytrends (otherwise .venv or system python)
# TRENDS_PYTHON=/ssd/www/wordstat/.venv/bin/python

# Platform-level paid providers (optional; Free users still forced to google_trends)
SERPAPI_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
AHREFS_API_TOKEN=

# Stripe (optional env fallback; prefer Admin → Payment gateways)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# RUB↔USD for FreeKassa world / NOWPayments / PayPal (approx)
USD_RUB_RATE=90

# Payment gateways (YooKassa, FreeKassa, Platega, FriendlyPay, NOWPayments, BetaTransfer,
# Stripe, PayPal, Overpay, Exnode, Bybit, …) are configured in Admin → Payment gateways
# Webhooks: https://wordstat.1tlt.ru/api/billing/webhook/{code}

# Optional Postgres cutover (when set, prefer docker compose postgres)
# DATABASE_URL=postgresql://wordstat:wordstat@127.0.0.1:5433/wordstat

# Redis (rate limits — optional; falls back to SQLite usage_events)
REDIS_URL=redis://127.0.0.1:6379
